Set-StrictMode -Version 2.0

function Get-RecoveryInformation { param([Parameter(Mandatory=$true)]$Action,[AllowNull()]$BackupManifest);[pscustomobject][ordered]@{ActionId=$Action.ActionId;AffectedPaths=@($Action.AffectedPaths);RollbackInformation=$Action.RollbackInformation;BackupManifestId=if($BackupManifest){$BackupManifest.ManifestId}else{$null};RecoveryRequired=$true} }
function Invoke-ActionRollback { param([Parameter(Mandatory=$true)]$Action,[Parameter(Mandatory=$true)]$Operation,[Parameter(Mandatory=$true)]$Handler,[Parameter(Mandatory=$true)]$Context);if(-not $Handler.PSObject.Properties['Rollback'] -or -not $Handler.Rollback){throw 'Action handler does not provide a rollback scriptblock.'};try{$result=& $Handler.Rollback $Action $Operation $Context;[pscustomobject][ordered]@{Status='RolledBack';Result=$result;Error=$null}}catch{$message=if($_.Exception){$_.Exception.Message}else{[string]$_};[pscustomobject][ordered]@{Status='Failed';Result=$null;Error=($message -replace '(?i)(bearer\s+)[^\s;]+','$1[REDACTED]' -replace '(?i)((?:token|secret|password|passwd|api[_-]?key|access[_-]?key)\s*[:=]\s*)[^\s,;]+','$1[REDACTED]')}}}
Export-ModuleMember -Function Get-RecoveryInformation,Invoke-ActionRollback
