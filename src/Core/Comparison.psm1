Set-StrictMode -Version 2.0

function Resolve-AuditValue {
    param([AllowNull()][string]$Value,[Parameter(Mandatory=$true)]$Configuration)
    if($null -eq $Value){return $null}
    $result=$Value;$aliases=@{}
    if($Configuration.defaults -and $Configuration.defaults.PSObject.Properties['paths']){foreach($p in $Configuration.defaults.paths.PSObject.Properties){$aliases[$p.Name]=[string]$p.Value}}
    $aliases['USERPROFILE']=[Environment]::GetFolderPath('UserProfile');$aliases['USERNAME']=[Environment]::UserName
    foreach($key in $aliases.Keys){$result=$result.Replace('%'+$key+'%',$aliases[$key])}
    return [Environment]::ExpandEnvironmentVariables($result)
}

function New-AuditFinding {
    param([string]$Component,[string]$Expected,[string]$Actual,[ValidateSet('PASS','WARNING','MISMATCH','MISSING','UNKNOWN')][string]$Status,[string]$RecommendedAction,[bool]$SafeToAutomate=$false,[ValidateSet('Configuration','Informational','Capability')][string]$Classification='Configuration')
    [pscustomobject][ordered]@{Component=$Component;ExpectedState=$Expected;ActualState=$Actual;Status=$Status;Classification=$Classification;RecommendedAction=$RecommendedAction;SafeToAutomate=$SafeToAutomate}
}

function Compare-PathRequirement {
    param($PathDiscovery,$ConfiguredPaths)
    $findings=@(); $actual=@($PathDiscovery.User.Entries)
    foreach($expected in $ConfiguredPaths){$resolved=[string]$expected;$match=@($actual | Where-Object {$_.TrimEnd('\\').ToLowerInvariant() -eq $resolved.TrimEnd('\\').ToLowerInvariant()});if($match.Count){$findings+=New-AuditFinding "PATH user: $resolved" $resolved ($match -join '; ') 'PASS' 'No action required.' $false}else{$findings+=New-AuditFinding "PATH user: $resolved" $resolved 'Missing' 'MISSING' 'Plan an additive user PATH update after explicit approval.' $false}}
    foreach($scope in @('User','Machine')){$scopeData=$PathDiscovery.User;if($scope -eq 'Machine'){$scopeData=$PathDiscovery.Machine};foreach($duplicate in @($scopeData.Duplicates)){$findings+=New-AuditFinding "PATH $scope duplicate" $duplicate.Normalized (($duplicate.Entries -join '; ')) 'MISMATCH' 'Review and deduplicate only after confirming ownership.' $false};foreach($malformed in @($scopeData.MalformedCandidates)){$findings+=New-AuditFinding "PATH $scope malformed entry" 'One path per entry' $malformed 'MISMATCH' 'Review the raw PATH entry manually; do not auto-repair.' $false}}
    $crossScope=@();if($PathDiscovery.PSObject.Properties['CrossScopeDuplicates']){$crossScope=@($PathDiscovery.CrossScopeDuplicates)};foreach($duplicate in $crossScope){$entries=@($duplicate.Entries | ForEach-Object {$_.Scope+': '+$_.Entry});$findings+=New-AuditFinding 'PATH cross-scope duplicate' $duplicate.Normalized ($entries -join '; ') 'WARNING' 'Review whether user and machine ownership should remain duplicated.' $false 'Informational'}
    return $findings
}
function Compare-ConfiguredPathEntries {
    param($Entries,[string[]]$Configured,[string]$Scope)
    $f=@();foreach($expected in $Configured){$resolved=[string]$expected;$match=@($Entries | Where-Object {$_.TrimEnd('\\').ToLowerInvariant() -eq $resolved.TrimEnd('\\').ToLowerInvariant()});if($match.Count){$f+=New-AuditFinding "PATH $Scope`: $resolved" $resolved ($match -join '; ') 'PASS' 'No action required.' $false}else{$f+=New-AuditFinding "PATH $Scope`: $resolved" $resolved 'Missing' 'MISSING' "Plan an additive $Scope PATH update after explicit approval." $false}};return $f
}
function Get-PathEntryValues { param($PathDiscovery,[string]$Scope);$scopeData=$PathDiscovery.$Scope;if($scopeData -and $scopeData.PSObject.Properties['Entries']){return @($scopeData.Entries)};return @() }
function Get-ScopedEnvironmentValue { param($Environment,[string]$Scope,[string]$Name);$scopeData=$Environment.$Scope;if($scopeData -is [System.Collections.IDictionary]){if($scopeData.Contains($Name)){return [string]$scopeData[$Name]};return $null};if($scopeData -and $scopeData.PSObject.Properties[$Name]){return [string]$scopeData.PSObject.Properties[$Name].Value};return $null }

function Get-ToolActual { param($Discovery,[string]$Id);$tool=@($Discovery.Tools | Where-Object {$_.Name -eq $Id} | Select-Object -First 1);if($tool.Count){return $tool[0]};if($Id -eq 'python'){return [pscustomobject]@{Name='python';Path=$Discovery.PythonUv.PythonPath;Version=$Discovery.PythonUv.Version}};if($Id -eq 'go'){return [pscustomobject]@{Name='go';Path=$Discovery.Go.Path;Version=$Discovery.Go.Version}};return [pscustomobject]@{Name=$Id;Path=$null;Version=$null}}
function Compare-Applications { param($Configuration,$Discovery);$f=@();foreach($app in $Configuration.applications.applications){$actual=Get-ToolActual $Discovery $app.id;if(-not $app.enabled){$f+=New-AuditFinding "Application $($app.id)" 'Disabled' 'Disabled in desired configuration' 'WARNING' 'No action planned while this application is disabled.' $false 'Informational';continue};if(-not $actual.Path){$installed=@($Discovery.InstalledSoftware | Where-Object {$_.DisplayName -like ('*'+$app.displayName+'*')} | Select-Object -First 1);if($installed.Count){$actual=[pscustomobject]@{Path=$installed[0].InstallLocation;Version=$installed[0].DisplayVersion}}};if($actual.Path){$f+=New-AuditFinding "Application $($app.id)" $app.displayName $actual.Path 'PASS' 'No action required.' $false 'Capability'}else{$f+=New-AuditFinding "Application $($app.id)" $app.displayName 'Not discovered' 'MISSING' 'Plan installation only in a future explicitly approved task.' $false 'Capability'}};return $f}
function ConvertTo-ComparableVersion { param([AllowNull()][string]$Value);if([string]::IsNullOrWhiteSpace($Value)){return $null};$match=[regex]::Match($Value,'(?<!\d)(\d+(?:\.\d+){1,3})(?!\d)');if(-not $match.Success){return $null};try{return [version]$match.Groups[1].Value}catch{return $null}}
function Get-ToolVersion { param($Discovery,[string]$Id);if($Id -eq 'python'){return $Discovery.PythonUv.Version};if($Id -eq 'go'){return $Discovery.Go.Version};if($Id -eq 'docker'){return $Discovery.DockerWsl.DockerVersion};$tool=Get-ToolActual $Discovery $Id;return $tool.Version}
function Compare-Versions { param($Configuration,$Discovery);$f=@();foreach($property in $Configuration.versions.constraints.PSObject.Properties){$constraint=$property.Value;if($null -eq $constraint.minimum -and $null -eq $constraint.maximum){continue};$actualText=Get-ToolVersion $Discovery $property.Name;$actual=ConvertTo-ComparableVersion $actualText;if($null -eq $actual){$f+=New-AuditFinding "Version $($property.Name)" 'Configured version constraint' ([string]$actualText) 'UNKNOWN' 'Review the installed version manually.' $false;continue};$min=ConvertTo-ComparableVersion ([string]$constraint.minimum);$max=ConvertTo-ComparableVersion ([string]$constraint.maximum);$valid=$true;if($min -and $actual -lt $min){$valid=$false};if($max -and $actual -gt $max){$valid=$false};$expected=if($min -and $max){"$min <= version <= $max"}elseif($min){">= $min"}else{"<= $max"};$status=if($valid){'PASS'}else{'MISMATCH'};$action=if($valid){'No action required.'}else{'Review version compatibility; installation is outside this task.'};$f+=New-AuditFinding "Version $($property.Name)" $expected ([string]$actualText) $status $action $false 'Capability'};return $f}
function Compare-ConfiguredValue { param([string]$Component,[string]$Expected,[AllowNull()][string]$Actual,[string]$MissingAction='Review the configuration manually');if($null -eq $Actual -or [string]::IsNullOrWhiteSpace($Actual)){return New-AuditFinding $Component $Expected 'Not reported' 'UNKNOWN' $MissingAction $false};$same=$Actual.Trim().Trim('"') -ieq $Expected.Trim().Trim('"');if($same){return New-AuditFinding $Component $Expected $Actual 'PASS' 'No action required.' $false};return New-AuditFinding $Component $Expected $Actual 'MISMATCH' $MissingAction $false}
function Compare-PackageManagers { param($Configuration,$Discovery)
    $f=@();if(-not $Configuration.environment.PSObject.Properties['packageManagers']){return $f};$expected=[ordered]@{}
    foreach($manager in $Configuration.environment.packageManagers.PSObject.Properties){foreach($setting in $manager.Value.PSObject.Properties){$expected[($manager.Name+'.'+$setting.Name)]=Resolve-AuditValue ([string]$setting.Value) $Configuration}}
    $paths=$Discovery.PackageManagers.ConfigurationPaths
    foreach($key in $expected.Keys){$actual=$null;if($paths -is [System.Collections.IDictionary] -and $paths.Contains($key)){$actual=[string]$paths[$key]}elseif($paths.PSObject.Properties[$key]){$actual=[string]$paths.PSObject.Properties[$key].Value};$f+=Compare-ConfiguredValue "Package manager $key" $expected[$key] $actual 'Review package-manager configuration; do not change it during audit.'}
    return $f
}
function Compare-PythonUv { param($Configuration,$Discovery);$expected=Resolve-AuditValue ([string]$Configuration.storage.roots.python) $Configuration;$f=@();$prefix='';$pythonPath='';if($Discovery.PythonUv.PSObject.Properties['Prefix']){$prefix=[string]$Discovery.PythonUv.Prefix};if($Discovery.PythonUv.PSObject.Properties['PythonPath']){$pythonPath=[string]$Discovery.PythonUv.PythonPath};$expectedPrefix=Join-Path $expected 'uv-python';if($prefix -and $prefix.ToLowerInvariant().StartsWith($expectedPrefix.ToLowerInvariant())){$f+=New-AuditFinding 'Python interpreter prefix' $expectedPrefix $prefix 'PASS' 'No action required.' $false 'Capability'}else{$f+=Compare-ConfiguredValue 'Python interpreter prefix' $expectedPrefix $prefix 'Review uv Python installation path.'};if($pythonPath -and $pythonPath.ToLowerInvariant().StartsWith($expected.ToLowerInvariant())){$f+=New-AuditFinding 'Python interpreter path' $expected $pythonPath 'PASS' 'No action required.' $false 'Capability'}else{$f+=New-AuditFinding 'Python interpreter path' $expected $pythonPath 'MISMATCH' 'Review the Python interpreter path.' $false 'Capability'};return $f}
function Compare-Go { param($Configuration,$Discovery);$f=@();foreach($key in @('GOROOT','GOPATH','GOMODCACHE','GOCACHE','GOBIN')){$configured=$null;if($Configuration.environment.variables.PSObject.Properties[$key]){$configured=Resolve-AuditValue ([string]$Configuration.environment.variables.PSObject.Properties[$key].Value) $Configuration};$actual=$null;if($Discovery.Go.Environment.Contains($key)){$actual=[string]$Discovery.Go.Environment[$key]};if($configured){$f+=Compare-ConfiguredValue "Go $key" $configured $actual 'Review Go environment configuration.'}};return $f}
function Compare-EnvironmentScopes { param($Configuration,$Discovery);$f=@();foreach($scope in @('User','Machine','Process')){if(-not $Configuration.environment.PSObject.Properties[$scope]){continue};$configured=$Configuration.environment.$scope;foreach($property in $configured.PSObject.Properties){$expected=Resolve-AuditValue ([string]$property.Value) $Configuration;$actual=Get-ScopedEnvironmentValue $Discovery.Environment $scope $property.Name;$f+=Compare-ConfiguredValue "Environment $scope`: $($property.Name)" $expected $actual 'Review the scoped environment variable.'}};return $f}
function Compare-Drives { param($Configuration,$Discovery);$minimum=[double]10;if($Configuration.defaults.driveCapacity.minimumFreeGB){$minimum=[double]$Configuration.defaults.driveCapacity.minimumFreeGB};$paths=@();foreach($property in $Configuration.storage.roots.PSObject.Properties){$paths+=(Resolve-AuditValue ([string]$property.Value) $Configuration)};$f=@();foreach($qualifier in @($paths | ForEach-Object {if($_ -match '^(?<drive>[A-Za-z]):\\'){$Matches.drive+':'}} | Select-Object -Unique)){$drive=@($Discovery.Drives | Where-Object {$_.Name+':' -ieq $qualifier} | Select-Object -First 1);if(-not $drive.Count){$f+=New-AuditFinding "Drive capacity $qualifier" (">= $minimum GB free") 'Not discovered' 'UNKNOWN' 'Review drive availability manually.' $false 'Capability';continue};$free=[double]$drive[0].FreeGB;$status=if($free -ge $minimum){'PASS'}else{'WARNING'};$action=if($status -eq 'PASS'){'No action required.'}else{'Review capacity before future installation or migration.'};$f+=New-AuditFinding "Drive capacity $qualifier" (">= $minimum GB free") ("$free GB free") $status $action $false 'Informational'};return $f}
function Compare-DockerWslInfrastructure { param($Configuration,$Discovery)
    $f=@();$state=$Discovery.DockerWsl;$docker=if($state.PSObject.Properties['Docker']){$state.Docker}else{$null};$wsl=if($state.PSObject.Properties['WSL']){$state.WSL}else{$null}
    if($docker){$dockerStatus=if($docker.Available){'PASS'}else{'MISSING'};$dockerAction=if($dockerStatus -eq 'PASS'){'No action required.'}else{'Install Docker Desktop only through an approved installation plan.'};$f+=New-AuditFinding 'Docker Desktop installation' 'Docker CLI available' ([string]$docker.Path) $dockerStatus $dockerAction $false 'Capability';$daemonStatus=if(-not $docker.Available){'UNKNOWN'}elseif($docker.DaemonAvailable){'PASS'}else{'WARNING'};$f+=New-AuditFinding 'Docker daemon' 'Docker daemon responsive' ([string]$docker.DaemonDetails) $daemonStatus 'Start Docker Desktop or review daemon availability; do not move active VHDX files.' $false 'Informational';$expectedRoot=$null;if($Configuration.storage.PSObject.Properties['docker']){$expectedRoot=Resolve-AuditValue ([string]$Configuration.storage.docker.dataRoot) $Configuration};if($expectedRoot){$vhdx=@($docker.VirtualDisks);$actualRoot=if($vhdx.Count){Split-Path $vhdx[0].FullName -Parent}else{$null};$f+=Compare-ConfiguredValue 'Docker configured storage root' $expectedRoot $actualRoot 'Review Docker Desktop storage using its supported settings mechanism.'}}
    if($wsl){$wslStatus=if($wsl.Available){'PASS'}else{'MISSING'};$f+=New-AuditFinding 'WSL installation' 'wsl.exe available' ([string]$wsl.Path) $wslStatus 'Enable or install WSL only through an approved platform-specific plan.' $false 'Capability';$wslConfig=$null;if($Configuration.storage.PSObject.Properties['wsl']){$wslConfig=$Configuration.storage.wsl};if($wslConfig -and $wslConfig.PSObject.Properties['defaultDistribution']){$expected=[string]$wslConfig.defaultDistribution;$actual=[string]$wsl.DefaultDistribution;$f+=Compare-ConfiguredValue 'WSL default distribution' $expected $actual 'Review the default distribution before changing it.'};if($wslConfig){foreach($configured in @($wslConfig.distributions)){$expectedName=[string]$configured.name;$actual=@($wsl.Registrations | Where-Object {$_.Name -eq $expectedName} | Select-Object -First 1);if(-not $actual.Count){$f+=New-AuditFinding "WSL distribution $expectedName" $expectedName 'Not registered' 'MISSING' 'Plan export/import only after explicit approval and backup retention.' $false 'Capability';continue};$destination=Resolve-AuditValue ([string]$configured.destination) $Configuration;$f+=Compare-ConfiguredValue "WSL distribution $expectedName storage" $destination ([string]$actual[0].BasePath) 'Review distribution storage; never move an active VHDX directly.';if([string]$actual[0].State -eq 'Running'){$f+=New-AuditFinding "WSL distribution $expectedName state" 'Stopped for storage operations' 'Running' 'WARNING' 'Stop the distribution before any approved export/import workflow.' $false 'Informational'}}};if($wsl.Virtualization){foreach($property in @('VirtualizationFirmwareEnabled','SecondLevelAddressTranslationExtensions')){if($null -eq $wsl.Virtualization.$property){$f+=New-AuditFinding "WSL prerequisite $property" 'Available' 'Not reported' 'UNKNOWN' 'Review virtualization prerequisites manually.' $false 'Capability'}elseif(-not $wsl.Virtualization.$property){$f+=New-AuditFinding "WSL prerequisite $property" 'Enabled' 'Disabled' 'WARNING' 'Enable the prerequisite before WSL operations.' $false 'Capability'}}}}
    return $f
}
function Compare-AuditState {
    param([Parameter(Mandatory=$true)]$Configuration,[Parameter(Mandatory=$true)]$Discovery)
    $f=@();$roots=$Configuration.storage.roots
    foreach($property in $roots.PSObject.Properties){$path=Resolve-AuditValue ([string]$property.Value) $Configuration;$item=@($Discovery.DeveloperDirectories | Where-Object {$_.Path -eq $path} | Select-Object -First 1);if($item.Count -eq 0){$f+=New-AuditFinding "Directory $($property.Name)" $path 'Not inspected' 'UNKNOWN' 'Include this path in a bounded discovery probe.' $false}elseif($item[0].Exists){$f+=New-AuditFinding "Directory $($property.Name)" $path 'Exists' 'PASS' 'No action required.' $false}else{$f+=New-AuditFinding "Directory $($property.Name)" $path 'Missing' 'MISSING' 'Decide whether to create the configured directory; creation is not automated by this audit.' $false}}
    $userPath=@();$machinePath=@();if($Configuration.environment.path.PSObject.Properties['user']){$userPath=@($Configuration.environment.path.user | ForEach-Object {Resolve-AuditValue $_ $Configuration})};if($Configuration.environment.path.PSObject.Properties['machine']){$machinePath=@($Configuration.environment.path.machine | ForEach-Object {Resolve-AuditValue $_ $Configuration})};$f+=Compare-ConfiguredPathEntries (Get-PathEntryValues $Discovery.Path 'User') $userPath 'user';$f+=Compare-ConfiguredPathEntries (Get-PathEntryValues $Discovery.Path 'Machine') $machinePath 'machine';$f+=Compare-PathRequirement $Discovery.Path @();foreach($property in $Configuration.environment.variables.PSObject.Properties){$expected=Resolve-AuditValue ([string]$property.Value) $Configuration;$actual=Get-ScopedEnvironmentValue $Discovery.Environment 'User' $property.Name;$f+=Compare-ConfiguredValue "Environment user: $($property.Name)" $expected $actual 'Review the user environment variable.'};$f+=Compare-EnvironmentScopes $Configuration $Discovery
    $hasApplications=$false;$hasVersions=$false;if($Configuration -is [System.Collections.IDictionary]){$hasApplications=$Configuration.Contains('applications');$hasVersions=$Configuration.Contains('versions')}else{$hasApplications=$null -ne $Configuration.PSObject.Properties['applications'];$hasVersions=$null -ne $Configuration.PSObject.Properties['versions']};if($hasApplications){$f+=Compare-Applications $Configuration $Discovery};if($hasVersions){$f+=Compare-Versions $Configuration $Discovery};if($Discovery.PSObject.Properties['PackageManagers']){$f+=Compare-PackageManagers $Configuration $Discovery};if($Discovery.PSObject.Properties['PythonUv']){$f+=Compare-PythonUv $Configuration $Discovery};if($Discovery.PSObject.Properties['Go']){$f+=Compare-Go $Configuration $Discovery};if($Discovery.PSObject.Properties['Drives']){$f+=Compare-Drives $Configuration $Discovery};if($Discovery.PSObject.Properties['DockerWsl']){$f+=Compare-DockerWslInfrastructure $Configuration $Discovery}
    $userSite=$Discovery.PythonUv.UserSite;$pythonRoot=Resolve-AuditValue ([string]$roots.python) $Configuration;if($userSite -and $userSite.ToLowerInvariant().StartsWith(([Environment]::GetFolderPath('UserProfile')).ToLowerInvariant())){$f+=New-AuditFinding 'Python user-site' $pythonRoot $userSite 'WARNING' 'Review user-site package ownership; do not move packages automatically.' $false 'Informational'}
    $projects=Resolve-AuditValue ([string]$roots.projects) $Configuration;$projectItem=@($Discovery.DeveloperDirectories | Where-Object {$_.Path -eq $projects} | Select-Object -First 1);if($projectItem.Count -and $projectItem[0].Exists){$f+=New-AuditFinding 'Projects root' $projects 'Exists' 'PASS' 'No action required.' $false}else{$f+=New-AuditFinding 'Projects root' $projects 'Missing' 'MISSING' 'Decide whether to create the projects root separately.' $false}
    $junctionEnabled=$true;if($Configuration.junctions.PSObject.Properties['enabled']){$junctionEnabled=[bool]$Configuration.junctions.enabled};$junctionMode=if($junctionEnabled){'Enabled'}else{'Disabled'};$junctionActual=if($junctionEnabled){'Enabled'}else{'Disabled; audit-only inventory'};$f+=New-AuditFinding 'Junction management' $junctionMode $junctionActual 'WARNING' 'Junction mutation is disabled; no junction action will be planned.' $false 'Informational'
    foreach($j in $Configuration.junctions.junctions){$source=Resolve-AuditValue $j.source $Configuration;$target=Resolve-AuditValue $j.target $Configuration;$actual=@($Discovery.DeveloperDirectories | Where-Object {$_.Path -eq $source} | Select-Object -First 1);if(-not $actual.Count -or -not $actual[0].Exists){$f+=New-AuditFinding "Junction $source" $target 'Source missing' 'MISSING' 'Plan junction creation only after explicit approval and backup checks.' $false}elseif($actual[0].LinkType -ne 'Junction' -and $actual[0].LinkType -ne 'SymbolicLink'){$f+=New-AuditFinding "Junction $source" $target ('Exists as '+$actual[0].Attributes) 'MISMATCH' 'Review source before considering a junction.' $false}elseif($actual[0].Target -ne $target){$f+=New-AuditFinding "Junction $source" $target ([string]$actual[0].Target) 'MISMATCH' 'Review target and preserve recovery data before any repair.' $false}else{$f+=New-AuditFinding "Junction $source" $target $actual[0].Target 'PASS' 'No action required.' $false}}
    foreach($registration in @($Discovery.DockerWsl.Registrations)){if($registration.Name -eq 'Ubuntu'){$expected=Resolve-AuditValue ([string]$roots.ubuntuWsl) $Configuration;$status=if($registration.BasePath -eq $expected){'PASS'}else{'MISMATCH'};$f+=New-AuditFinding 'WSL Ubuntu storage' $expected $registration.BasePath $status 'Review WSL registration; do not move storage automatically.' $false}elseif($registration.Name -eq 'docker-desktop'){$expected=Join-Path (Resolve-AuditValue ([string]$roots.dockerWsl) $Configuration) 'main';$status=if($registration.BasePath -eq $expected -or $registration.BasePath -eq ('\\?\'+$expected)){'PASS'}else{'MISMATCH'};$f+=New-AuditFinding 'Docker WSL storage' $expected $registration.BasePath $status 'Review Docker Desktop storage location before any change.' $false}}
    if(@($Discovery.DockerWsl.Registrations).Count -eq 0){$f+=New-AuditFinding 'WSL registrations' 'Registered Ubuntu and docker-desktop distributions' 'No registrations observed' 'UNKNOWN' 'Run a privileged/manual WSL review if registration metadata is unavailable.' $false}
    return $f
}

Export-ModuleMember -Function New-AuditFinding,Compare-AuditState,Compare-PathRequirement,Compare-Versions,Compare-Drives,Compare-Applications,Compare-DockerWslInfrastructure
