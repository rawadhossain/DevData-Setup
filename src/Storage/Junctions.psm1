Set-StrictMode -Version 2.0
Import-Module (Join-Path $PSScriptRoot 'Verification.psm1')

function New-JunctionAction {
    param([Parameter(Mandatory=$true)][string]$ActionId,[Parameter(Mandatory=$true)][string]$Source,[Parameter(Mandatory=$true)][string]$Target)
    [pscustomobject][ordered]@{ActionId=$ActionId;Component='Storage junction';Description="Create junction: $Source -> $Target";ActionType='JUNCTION_CREATE';Risk='High';AffectedPaths=@($Source,$Target);Preconditions=@('Target exists.','Source is absent or already the correct junction.');Dependencies=@();ApprovalRequired=$true;SafeToAutomate=$false;RollbackInformation='Remove only the created junction after validating its target; never remove the target directory.';CurrentStatus='PROPOSED';StorageMetadata=[pscustomobject]@{Source=$Source;Target=$Target}}
}
function New-JunctionRepairAction {
    param([Parameter(Mandatory=$true)][string]$ActionId,[Parameter(Mandatory=$true)][string]$Source,[Parameter(Mandatory=$true)][string]$Target)
    $action=New-JunctionAction $ActionId $Source $Target;$action.Description="Repair junction target only after explicit review: $Source -> $Target";$action.ActionType='JUNCTION_REPAIR';$action.RollbackInformation='Recovery requires restoring the prior junction target or original directory from a preserved record.';return $action
}
function Get-JunctionInventory { param([Parameter(Mandatory=$true)][string[]]$Roots);$rows=@();foreach($root in $Roots){$rows+=Get-ChildItem -LiteralPath $root -Force -Directory -ErrorAction SilentlyContinue | Where-Object {$_.LinkType -eq 'Junction' -or $_.LinkType -eq 'SymbolicLink'} | ForEach-Object {[pscustomobject]@{Source=$_.FullName;LinkType=$_.LinkType;Target=if($_.Target){$_.Target -join ';'}else{$null};TargetExists=if($_.Target){Test-Path -LiteralPath ($_.Target -join ';')}else{$false}}}};return $rows}
function Get-JunctionRepairPlan { param([Parameter(Mandatory=$true)][string]$Source,[Parameter(Mandatory=$true)][string]$Target);$state=Test-JunctionState $Source $Target;if($state.Passed){return [pscustomobject]@{Needed=$false;Reason='Junction is correct.';Action=$null;Validation=$state}};$action=New-JunctionRepairAction ('JUNCTION-'+[guid]::NewGuid().ToString('N')) $Source $Target;[pscustomobject]@{Needed=$true;Reason=$state.Message;Action=$action;Validation=$state}}
function New-JunctionHandler {
    $handler=[pscustomobject][ordered]@{TestPrecondition=$null;Execute=$null;Rollback=$null}
    $handler.TestPrecondition={param($Action,$Context)$source=$Action.StorageMetadata.Source;$target=$Action.StorageMetadata.Target;$targetState=Get-StoragePathState $target;if(-not $targetState.Exists -or -not $targetState.IsDirectory -or $targetState.LinkType){return [pscustomobject]@{Passed=$false;Failures=@("Junction target is not an ordinary existing directory: $target")}};$state=Get-StoragePathState $source;if($state.Exists -and $state.LinkType -eq 'Junction' -and $state.Target.TrimEnd('\') -ieq $target.TrimEnd('\')){return [pscustomobject]@{Passed=$true;Failures=@()}};if($state.Exists){return [pscustomobject]@{Passed=$false;Failures=@("Junction source is occupied by an existing path: $source")}};[pscustomobject]@{Passed=$true;Failures=@()}}.GetNewClosure()
    $handler.Execute={param($Action,$Context)$source=$Action.StorageMetadata.Source;$target=$Action.StorageMetadata.Target;$state=Get-StoragePathState $source;if($state.Exists -and $state.LinkType -eq 'Junction' -and $state.Target.TrimEnd('\') -ieq $target.TrimEnd('\')){return [pscustomobject]@{Status='AlreadyCorrect';Source=$source;Target=$target;Created=$false}};if($state.Exists){throw "Junction source is occupied or has the wrong link type: $source"};if(-not (Test-Path -LiteralPath $target -PathType Container)){throw "Junction target does not exist: $target"};New-Item -ItemType Junction -Path $source -Target $target -ErrorAction Stop | Out-Null;$verification=Test-JunctionState $source $target;if(-not $verification.Passed){throw "Junction verification failed: $($verification.Message)"};[pscustomobject]@{Status='Created';Source=$source;Target=$target;Created=$true}}.GetNewClosure()
    $handler.Rollback={param($Action,$Operation,$Context)$source=$Action.StorageMetadata.Source;$target=$Action.StorageMetadata.Target;$verification=Test-JunctionState $source $target;if($verification.Status -eq 'Correct'){Remove-Item -LiteralPath $source -Force -Confirm:$false -ErrorAction Stop;return [pscustomobject]@{Status='RemovedCreatedJunction';Source=$source;Target=$target}};[pscustomobject]@{Status='ManualRecoveryRequired';Source=$source;Target=$target;ObservedStatus=$verification.Status}}.GetNewClosure()
    return $handler
}
Export-ModuleMember -Function New-JunctionAction,New-JunctionRepairAction,Get-JunctionInventory,Get-JunctionRepairPlan,New-JunctionHandler
